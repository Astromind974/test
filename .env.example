# Exemple de fichier de configuration d'environnement
# Copiez ce fichier en `.env` et remplissez vos propres valeurs.
# ⚠️ Ne committez JAMAIS le fichier `.env` dans Git !

# Application
APP_NAME=test
APP_ENV=development
APP_PORT=3000

# Base de données (exemple)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ma_base
# DB_USER=mon_utilisateur
# DB_PASSWORD=mon_mot_de_passe

# Clé secrète (exemple)
# SECRET_KEY=changez_moi_en_production
