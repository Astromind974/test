# Exemple de fichier de configuration d'environnement
# Copiez ce fichier en `.env` et adaptez les valeurs.
# ⚠️ Ne committez JAMAIS le fichier `.env` dans Git !

# --- Service IA Python (ai_service/main.py) ---
AI_SERVICE_PORT=5001

# --- Backend Node.js/Express (backend/) ---
BACKEND_PORT=3001
AI_SERVICE_URL=http://localhost:5001

# --- Frontend React/Vite (frontend/) ---
# En développement : serveur Vite sur le port 3000, proxy vers BACKEND_PORT

# --- Paramètres communs ---
APP_ENV=development          # "development" | "production"
DB_PATH=results.db           # Chemin du fichier SQLite
